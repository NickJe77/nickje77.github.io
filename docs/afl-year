<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<title>AFL Year by Year | The Sporting Almanac</title>
<meta name="viewport" content="width=device-width, initial-scale=1.0">

<link rel="stylesheet" href="style.css">

<style>
body{
  font-family: Inter, system-ui, -apple-system, BlinkMacSystemFont,
               "Segoe UI", Roboto, Helvetica, Arial, sans-serif;
}
.year-tabs button.active{background:#000;color:#fff;}
.game{padding:8px;border-bottom:1px solid #ddd;cursor:pointer;}
.game:hover{background:#f5f5f5;}
.player-table{width:100%;border-collapse:collapse;margin-top:10px;}
.player-table th,.player-table td{border:1px solid #ddd;padding:6px;text-align:center;}
.player-table th{background:#f0f0f0;}
</style>
</head>

<body>

<nav class="home-nav">
  <a href="index.html">Home</a>
  <a href="racing.html">Racing</a>
  <a href="afl.html">AFL</a>
  <a href="football.html">Football</a>
  <a href="cricket.html">Cricket</a>
  <a href="f1.html">F1</a>
</nav>

<h1 style="padding:20px 20px 0;">AFL Year by Year</h1>

<div class="year-tabs" id="years" style="padding:10px 20px;"></div>
<div id="rounds" style="padding:10px 20px;"></div>
<div id="games" style="padding:10px 20px;"></div>
<div id="players" style="padding:10px 20px;"></div>

<script>
let data=[];

const yearsBox=document.getElementById("years");
const roundsBox=document.getElementById("rounds");
const gamesBox=document.getElementById("games");
const playersBox=document.getElementById("players");

fetch("data/afl.json",{cache:"no-store"})
.then(r=>r.json())
.then(d=>{
  data=d;
  buildYears();
});

function buildYears(){
 const years=[...new Set(data.map(m=>m.year))].sort((a,b)=>a-b);

 years.forEach(y=>{
  const b=document.createElement("button");
  b.textContent=y;
  b.onclick=()=>loadYear(y,b);
  yearsBox.appendChild(b);
 });

 // auto load latest year
 const lastBtn=yearsBox.lastChild;
 if(lastBtn) lastBtn.click();
}

function loadYear(year,btn){
 document.querySelectorAll(".year-tabs button").forEach(b=>b.classList.remove("active"));
 btn.classList.add("active");

 roundsBox.innerHTML="";
 gamesBox.innerHTML="";
 playersBox.innerHTML="";

 const rounds=[...new Set(data.filter(m=>m.year==year).map(m=>m.round))];

 rounds.forEach(r=>{
  const b=document.createElement("button");
  b.textContent="Round "+r;
  b.onclick=()=>loadRound(year,r);
  roundsBox.appendChild(b);
 });
}

function loadRound(year,round){
 gamesBox.innerHTML="";
 playersBox.innerHTML="";

 data.filter(m=>m.year==year&&m.round==round).forEach(m=>{
  const d=document.createElement("div");
  d.className="game";
  d.textContent=`${m.home} ${m.home_score} def ${m.away} ${m.away_score} – ${m.venue}`;
  d.onclick=()=>loadPlayers(m);
  gamesBox.appendChild(d);
 });
}

function loadPlayers(match){
 playersBox.innerHTML=`
 <h3>${match.home} vs ${match.away}</h3>
 <table class="player-table">
 <tr><th>Player</th><th>Team</th><th>G</th><th>D</th><th>M</th><th>T</th></tr>
 ${match.players.map(p=>`
 <tr>
 <td>${p.player}</td>
 <td>${p.team}</td>
 <td>${p.goals}</td>
 <td>${p.disposals}</td>
 <td>${p.marks}</td>
 <td>${p.tackles}</td>
 </tr>`).join("")}
 </table>`;
}
</script>

</body>
</html>
