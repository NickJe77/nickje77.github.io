const yearFilter = document.getElementById("yearFilter");
const raceFilter = document.getElementById("raceFilter");
const winnerFilter = document.getElementById("winnerFilter");
const tableBody = document.querySelector(".archive-table tbody");

let allResults = [];

fetch("data/hong-kong-results.json")
  .then(res => res.json())
  .then(data => {
    allResults = data;
    populateFilters(data);
    renderTable(data);
  })
  .catch(err => console.error("Hong Kong data error:", err));

function populateFilters(data) {
  const years = [...new Set(data.map(r => r.year))].sort((a, b) => b - a);
  const races = [...new Set(data.map(r => r.race))];
  const winners = [...new Set(data.map(r => r.winner))];

  years.forEach(y => {
    const o = document.createElement("option");
    o.value = y;
    o.textContent = y;
    yearFilter.appendChild(o);
  });

  races.forEach(r => {
    const o = document.createElement("option");
    o.value = r;
    document.getElementById("raceList").appendChild(o);
  });

  winners.forEach(w => {
    const o = document.createElement("option");
    o.value = w;
    document.getElementById("winnerList").appendChild(o);
  });
}

function applyFilters() {
  let data = [...allResults];

  if (yearFilter.value)
    data = data.filter(r => r.year == yearFilter.value);

  if (raceFilter.value)
    data = data.filter(r =>
      r.race.toLowerCase().includes(raceFilter.value.toLowerCase())
    );

  if (winnerFilter.value)
    data = data.filter(r =>
      r.winner.toLowerCase().includes(winnerFilter.value.toLowerCase())
    );

  renderTable(data);
}

function renderTable(data) {
  tableBody.innerHTML = "";

  data.forEach(r => {
    const tr = document.createElement("tr");
    tr.innerHTML = `
      <td>${r.year}</td>
      <td>${r.race}</td>
      <td>${r.winner}</td>
      <td>${r.trainer}</td>
      <td>${r.jockey}</td>
    `;
    tableBody.appendChild(tr);
  });
}

yearFilter.addEventListener("change", applyFilters);
raceFilter.addEventListener("input", applyFilters);
winnerFilter.addEventListener("input", applyFilters);
