document.addEventListener("DOMContentLoaded", () => {
  const yearSelect = document.getElementById("yearFilter");
  const raceInput = document.getElementById("raceFilter");
  const winnerInput = document.getElementById("winnerFilter");
  const tableBody = document.querySelector(".archive-table tbody");

  let results = [];

  fetch("data/hong-kong-results.json")
    .then(res => {
      if (!res.ok) throw new Error("JSON not found");
      return res.json();
    })
    .then(data => {
      results = data.sort((a, b) => b.year - a.year);
      populateYearFilter();
      renderTable(results);
    })
    .catch(err => {
      console.error("Hong Kong data load failed:", err);
    });

  function populateYearFilter() {
    const years = [...new Set(results.map(r => r.year))].sort((a, b) => b - a);
    years.forEach(year => {
      const opt = document.createElement("option");
      opt.value = year;
      opt.textContent = year;
      yearSelect.appendChild(opt);
    });
  }

  function renderTable(data) {
    tableBody.innerHTML = "";

    data.forEach(row => {
      const tr = document.createElement("tr");

      tr.innerHTML = `
        <td>${row.year}</td>
        <td>${row.race}</td>
        <td>${row.winner}</td>
        <td>${row.trainer}</td>
        <td>${row.jockey}</td>
      `;

      tableBody.appendChild(tr);
    });
  }

  function applyFilters() {
    const year = yearSelect.value;
    const race = raceInput.value.toLowerCase();
    const winner = winnerInput.value.toLowerCase();

    const filtered = results.filter(r => {
      return (
        (!year || r.year == year) &&
        (!race || r.race.toLowerCase().includes(race)) &&
        (!winner || r.winner.toLowerCase().includes(winner))
      );
    });

    renderTable(filtered);
  }

  yearSelect.addEventListener("change", applyFilters);
  raceInput.addEventListener("input", applyFilters);
  winnerInput.addEventListener("input", applyFilters);
});
